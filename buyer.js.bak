
"use strict";

document.addEventListener("DOMContentLoaded", () => {
    const API = {
        me: "/api/auth/me",
        logout: "/api/auth/logout",
        products: "/api/buyer/products",
        orders: "/api/buyer/orders"
    };

    const $ = (selector) => document.querySelector(selector);

    const state = {
        user: null,
        products: [],
        orders: [],
        selectedProduct: null,
        loadingOrder: false
    };

    const currency = new Intl.NumberFormat("en-ZM", {
        style: "currency",
        currency: "ZMW",
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    const formatMoney = (value) => {
        const amount = Number(value);
        return currency.format(Number.isFinite(amount) ? amount : 0);
    };

    const escapeHTML = (value) =>
        String(value ?? "").replace(/[&<>"']/g, character => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[character]);

    const firstValue = (object, keys, fallback = "") => {
        for (const key of keys) {
            if (
                object &&
                object[key] !== undefined &&
                object[key] !== null &&
                object[key] !== ""
            ) {
                return object[key];
            }
        }

        return fallback;
    };

    const productId = product =>
        firstValue(product, ["product_id", "productId", "id"]);

    const productName = product =>
        firstValue(product, ["product_name", "productName", "name"], "Product");

    const productPrice = product =>
        Number(firstValue(product, ["price", "unit_price", "unitPrice"], 0));

    const productQuantity = product =>
        Number(firstValue(product, ["quantity", "stock", "available_quantity"], 0));

    const productUnit = product =>
        firstValue(product, ["unit", "measurement_unit"], "unit");

    const farmerName = product =>
        firstValue(
            product,
            ["farmer_name", "farmerName", "full_name", "seller_name"],
            "Local farmer"
        );

    const orderId = order =>
        firstValue(order, ["order_id", "orderId", "id"], "—");

    const orderStatus = order =>
        String(firstValue(order, ["status", "order_status"], "pending"))
            .toLowerCase()
            .trim();

    const orderTotal = order =>
        Number(firstValue(order, ["total_price", "totalPrice", "total"], 0));

    const orderQuantity = order =>
        Number(firstValue(order, ["quantity", "order_quantity"], 0));

    const orderProductName = order =>
        firstValue(
            order,
            ["product_name", "productName", "name"],
            "Product"
        );

    function showMessage(text, type = "info") {
        const box = $("#messageBox");
        box.textContent = text;
        box.className = `message-box ${type}`;
        box.hidden = false;

        if (type === "success") {
            window.setTimeout(() => {
                if (box.textContent === text) box.hidden = true;
            }, 5000);
        }

        box.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    function clearMessage() {
        $("#messageBox").hidden = true;
        $("#messageBox").textContent = "";
    }

    async function apiRequest(url, options = {}) {
        const response = await fetch(url, {
            credentials: "same-origin",
            ...options,
            headers: {
                ...(options.body ? { "Content-Type": "application/json" } : {}),
                ...(options.headers || {})
            }
        });

        const data = await response.json().catch(() => ({}));

        if (response.status === 401) {
            window.location.assign("/login/login.html");
            throw new Error("Your session has expired. Please log in again.");
        }

        if (!response.ok) {
            throw new Error(
                data.message ||
                data.error ||
                `Request failed (${response.status}).`
            );
        }

        return data;
    }

    function getArray(data, key) {
        if (Array.isArray(data)) return data;
        if (Array.isArray(data[key])) return data[key];
        return [];
    }

    function getInitials(name) {
        return String(name || "Buyer")
            .trim()
            .split(/\s+/)
            .slice(0, 2)
            .map(part => part[0] || "")
            .join("")
            .toUpperCase() || "B";
    }

    function displayUser(user) {
        state.user = user;

        const name = firstValue(
            user,
            ["fullName", "full_name", "name"],
            "Buyer"
        );

        const email = firstValue(user, ["email"], "—");

        $("#welcomeName").textContent = name.split(/\s+/)[0] || "Buyer";
        $("#sidebarName").textContent = name;
        $("#profileAvatar").textContent = getInitials(name);
        $("#topAvatar").textContent = getInitials(name);
        $("#accountAvatar").textContent = getInitials(name);
        $("#accountName").textContent = name;
        $("#accountFullName").textContent = name;
        $("#accountEmail").textContent = email;

        const role = String(firstValue(user, ["role"], "")).toLowerCase();

        if (role && role !== "buyer") {
            showMessage(
                "This page is for buyer accounts. Please sign in with a buyer account.",
                "error"
            );
            window.location.assign(
                role === "farmer"
                    ? "/dashboard/farmer.html"
                    : "/login/login.html"
            );
        }
    }

    function isAvailable(product) {
        const status = String(
            firstValue(product, ["status", "product_status"], "available")
        ).toLowerCase();

        return status === "available" && productQuantity(product) > 0;
    }

    function placeholderEmoji(name) {
        const value = String(name).toLowerCase();

        if (value.includes("tomato")) return "🍅";
        if (value.includes("maize") || value.includes("corn")) return "🌽";
        if (value.includes("potato")) return "🥔";
        if (value.includes("onion")) return "🧅";
        if (value.includes("cabbage")) return "🥬";
        if (value.includes("egg")) return "🥚";
        if (value.includes("chicken")) return "🐓";
        if (value.includes("banana")) return "🍌";
        if (value.includes("bean")) return "🫘";
        if (value.includes("carrot")) return "🥕";
        if (value.includes("pepper")) return "🌶️";

        return "🌱";
    }

    function renderProductCard(product) {
        const id = productId(product);
        const name = productName(product);
        const price = productPrice(product);
        const unit = productUnit(product);
        const quantity = productQuantity(product);
        const farmer = farmerName(product);
        const location = firstValue(
            product,
            ["location", "farmer_location", "farmerLocation"],
            "Location not provided"
        );
        const description = firstValue(
            product,
            ["description"],
            "Fresh produce offered by a local farmer."
        );
        const image = firstValue(
            product,
            ["image_url", "imageUrl", "image"],
            ""
        );
        const available = isAvailable(product);

        const safeImage = typeof image === "string" &&
            /^https?:\/\//i.test(image.trim());

        const imageMarkup = safeImage
            ? `<img src="${escapeHTML(image)}"
                    alt="${escapeHTML(name)}"
                    loading="lazy"
                    onerror="this.style.display='none';this.nextElementSibling.hidden=false">
               <span class="product-placeholder" hidden>${placeholderEmoji(name)}</span>`
            : `<span class="product-placeholder">${placeholderEmoji(name)}</span>`;

        return `
            <article class="product-card">
                <div class="product-image">
                    ${imageMarkup}
                    <span class="product-availability"
                          style="${available ? "" : "background:#ffebeb;color:#b42318"}">
                        ${available ? "Available" : "Unavailable"}
                    </span>
                </div>
                <div class="product-body">
                    <p class="product-category">Farm fresh</p>
                    <h3 class="product-name">${escapeHTML(name)}</h3>
                    <p class="product-description">${escapeHTML(description)}</p>
                    <div class="product-meta">
                        <span>♙ ${escapeHTML(farmer)}</span>
                        <span>⌖ ${escapeHTML(location)}</span>
                        <span>Stock: ${escapeHTML(quantity)} ${escapeHTML(unit)}</span>
                    </div>
                    <div class="product-bottom">
                        <div class="product-price">
                            ${escapeHTML(formatMoney(price))}
                            <small>/ ${escapeHTML(unit)}</small>
                        </div>
                        <button
                            type="button"
                            class="button button-primary order-product-btn"
                            data-order-product="${escapeHTML(id)}"
                            ${!available || id === "" ? "disabled" : ""}>
                            Order now
                        </button>
                    </div>
                </div>
            </article>
        `;
    }

    function renderProductList(products, container, emptyText) {
        if (!products.length) {
            container.innerHTML = `
                <div class="empty-state">
                    <span>🌱</span>
                    <h3>No products found</h3>
                    <p>${escapeHTML(emptyText)}</p>
                </div>
            `;
            return;
        }

        container.innerHTML = products
            .map(renderProductCard)
            .join("");
    }

    function filteredProducts() {
        const query = $("#productSearch").value.trim().toLowerCase();
        const sort = $("#sortProducts").value;

        const result = state.products.filter(product => {
            const searchable = [
                productName(product),
                farmerName(product),
                firstValue(product, ["location", "farmer_location"], ""),
                firstValue(product, ["description"], ""),
                productUnit(product)
            ].join(" ").toLowerCase();

            return searchable.includes(query);
        });

        result.sort((a, b) => {
            if (sort === "name") {
                return productName(a).localeCompare(productName(b));
            }

            if (sort === "price-low") {
                return productPrice(a) - productPrice(b);
            }

            if (sort === "price-high") {
                return productPrice(b) - productPrice(a);
            }

            const dateA = new Date(
                firstValue(a, ["created_at", "createdAt"], 0)
            ).getTime() || 0;

            const dateB = new Date(
                firstValue(b, ["created_at", "createdAt"], 0)
            ).getTime() || 0;

            return dateB - dateA;
        });

        return result;
    }

    function renderMarketplace() {
        const filtered = filteredProducts();

        $("#productResultCount").textContent =
            `${filtered.length} product${filtered.length === 1 ? "" : "s"} found`;

        renderProductList(
            filtered,
            $("#productsContainer"),
            "Try another search or check back later."
        );

        const featured = [...state.products].slice(0, 3);

        renderProductList(
            featured,
            $("#featuredProducts"),
            "Products will appear here when farmers list their produce."
        );

        $("#availableCount").textContent =
            state.products.filter(isAvailable).length;
    }

    function statusMarkup(status) {
        const knownStatuses = [
            "pending", "accepted", "completed", "rejected", "cancelled"
        ];

        const safeStatus = knownStatuses.includes(status)
            ? status
            : "unknown";

        const label = safeStatus === "unknown"
            ? "Unknown"
            : safeStatus.charAt(0).toUpperCase() + safeStatus.slice(1);

        return `<span class="status-badge status-${safeStatus}">${label}</span>`;
    }

    function formatDate(value) {
        if (!value) return "—";

        const date = new Date(value);

        if (Number.isNaN(date.getTime())) {
            return "—";
        }

        return date.toLocaleDateString("en-ZM", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        });
    }

    function renderRecentOrders() {
        const recent = [...state.orders].slice(0, 5);
        const body = $("#recentOrdersBody");

        if (!recent.length) {
            body.innerHTML = `
                <tr><td colspan="5" class="empty-cell">
                    No orders yet. Browse the marketplace to get started.
                </td></tr>`;
            return;
        }

        body.innerHTML = recent.map(order => `
            <tr>
                <td class="order-id">#${escapeHTML(orderId(order))}</td>
                <td>${escapeHTML(orderProductName(order))}</td>
                <td>${escapeHTML(orderQuantity(order))}</td>
                <td>${escapeHTML(formatMoney(orderTotal(order)))}</td>
                <td>${statusMarkup(orderStatus(order))}</td>
            </tr>
        `).join("");
    }

    function renderOrders() {
        const query = $("#orderSearch").value.trim().toLowerCase();
        const selectedStatus = $("#orderStatusFilter").value;

        const filtered = state.orders.filter(order => {
            const matchesQuery = [
                orderId(order),
                orderProductName(order),
                firstValue(order, ["farmer_name", "farmerName"], "")
            ].join(" ").toLowerCase().includes(query);

            const matchesStatus =
                selectedStatus === "all" ||
                orderStatus(order) === selectedStatus;

            return matchesQuery && matchesStatus;
        });

        const body = $("#ordersTableBody");
        $("#ordersEmpty").hidden = filtered.length !== 0;
        body.closest("table").hidden = filtered.length === 0;

        body.innerHTML = filtered.map(order => `
            <tr>
                <td class="order-id">#${escapeHTML(orderId(order))}</td>
                <td>${escapeHTML(orderProductName(order))}</td>
                <td>${escapeHTML(firstValue(
                    order, ["farmer_name", "farmerName"], "—"
                ))}</td>
                <td>${escapeHTML(orderQuantity(order))}</td>
                <td>${escapeHTML(formatMoney(orderTotal(order)))}</td>
                <td>${escapeHTML(formatDate(firstValue(
                    order, ["created_at", "createdAt", "order_date"], ""
                )))}</td>
                <td>${statusMarkup(orderStatus(order))}</td>
            </tr>
        `).join("");
    }

    function renderStats() {
        $("#totalOrders").textContent = state.orders.length;

        $("#pendingOrders").textContent = state.orders.filter(order =>
            orderStatus(order) === "pending"
        ).length;

        $("#completedOrders").textContent = state.orders.filter(order =>
            orderStatus(order) === "completed"
        ).length;
    }

    async function loadProducts() {
        $("#productsContainer").innerHTML =
            '<div class="loading-state">Loading marketplace…</div>';

        try {
            const data = await apiRequest(API.products);
            state.products = getArray(data, "products");
            renderMarketplace();
        } catch (error) {
            $("#productsContainer").innerHTML = `
                <div class="empty-state">
                    <h3>Unable to load products</h3>
                    <p>${escapeHTML(error.message)}</p>
                    <button class="button button-primary" id="retryProducts"
                            type="button">Try again</button>
                </div>
            `;
            $("#featuredProducts").innerHTML =
                '<div class="loading-state">Products could not be loaded.</div>';
        }
    }

    async function loadOrders() {
        $("#ordersTableBody").innerHTML =
            '<tr><td colspan="7" class="empty-cell">Loading orders…</td></tr>';

        try {
            const data = await apiRequest(API.orders);
            state.orders = getArray(data, "orders");

            renderStats();
            renderOrders();
            renderRecentOrders();
        } catch (error) {
            $("#ordersTableBody").innerHTML = `
                <tr><td colspan="7" class="empty-cell">
                    ${escapeHTML(error.message)}
                </td></tr>`;
            $("#recentOrdersBody").innerHTML = `
                <tr><td colspan="5" class="empty-cell">
                    Could not load recent orders.
                </td></tr>`;
        }
    }

    function openOrderModal(id) {
        const product = state.products.find(item =>
            String(productId(item)) === String(id)
        );

        if (!product) {
            showMessage(
                "This product could not be found. Refresh the marketplace and try again.",
                "error"
            );
            return;
        }

        if (!isAvailable(product)) {
            showMessage("This product is currently unavailable.", "error");
            return;
        }

        state.selectedProduct = product;

        $("#orderProductId").value = productId(product);
        $("#modalProductName").textContent = productName(product);
        $("#modalFarmerName").textContent = farmerName(product);
        $("#modalProductPrice").textContent =
            `${formatMoney(productPrice(product))} / ${productUnit(product)}`;
        $("#modalProductDescription").textContent =
            firstValue(product, ["description"], "Review your order details.");
        $("#orderQuantity").value = "1";

        const stock = productQuantity(product);
        $("#orderQuantity").max = String(stock);
        $("#quantityHelp").textContent =
            `Available stock: ${stock} ${productUnit(product)}.`;

        updateOrderTotal();

        $("#orderModal").hidden = false;
        document.body.style.overflow = "hidden";
        $("#orderQuantity").focus();
    }

    function closeOrderModal() {
        if (state.loadingOrder) return;

        $("#orderModal").hidden = true;
        document.body.style.overflow = "";
        state.selectedProduct = null;
    }

    function updateOrderTotal() {
        if (!state.selectedProduct) return;

        const quantity = Number($("#orderQuantity").value);
        const stock = productQuantity(state.selectedProduct);

        const validQuantity =
            Number.isInteger(quantity) &&
            quantity >= 1 &&
            quantity <= stock;

        $("#estimatedTotal").textContent = validQuantity
            ? formatMoney(productPrice(state.selectedProduct) * quantity)
            : "—";

        $("#placeOrderBtn").disabled = !validQuantity || state.loadingOrder;

        if (!validQuantity) {
            $("#quantityHelp").textContent =
                `Enter a whole number from 1 to ${stock}.`;
        } else {
            $("#quantityHelp").textContent =
                `Available stock: ${stock} ${productUnit(state.selectedProduct)}.`;
        }
    }

    async function placeOrder(event) {
        event.preventDefault();

        if (state.loadingOrder || !state.selectedProduct) return;

        const quantity = Number($("#orderQuantity").value);
        const product = state.selectedProduct;
        const stock = productQuantity(product);

        if (!Number.isInteger(quantity) || quantity < 1 || quantity > stock) {
            showMessage("Enter a valid quantity within the available stock.", "error");
            return;
        }

        state.loadingOrder = true;
        $("#placeOrderBtn").disabled = true;
        $("#placeOrderBtn").textContent = "Submitting order…";

        try {
            const data = await apiRequest(API.orders, {
                method: "POST",
                body: JSON.stringify({
                    productId: productId(product),
                    quantity
                })
            });

            closeOrderModal();

            showMessage(
                data.message || "Order placed successfully. Await farmer confirmation.",
                "success"
            );

            await Promise.all([loadOrders(), loadProducts()]);
            showSection("orders");
        } catch (error) {
            showMessage(error.message || "Could not place your order.", "error");
        } finally {
            state.loadingOrder = false;
            $("#placeOrderBtn").disabled = false;
            $("#placeOrderBtn").textContent = "Confirm order";
            updateOrderTotal();
        }
    }

    function showSection(sectionId) {
        const allowed = ["overview", "marketplace", "orders", "account"];
        if (!allowed.includes(sectionId)) sectionId = "overview";

        document.querySelectorAll(".dashboard-section").forEach(section => {
            section.hidden = section.id !== sectionId;
        });

        document.querySelectorAll(".nav-link[data-section]").forEach(link => {
            const active = link.dataset.section === sectionId;
            link.classList.toggle("active", active);

            if (active) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });

        const labels = {
            overview: "Overview",
            marketplace: "Marketplace",
            orders: "My Orders",
            account: "My Account"
        };

        $("#pageName").textContent = labels[sectionId];
        $("#sidebar").classList.remove("open");
        window.location.hash = sectionId;

        if (sectionId === "orders") {
            renderOrders();
        }
    }

    async function logout() {
        const confirmed = window.confirm(
            "Are you sure you want to log out of AgroConnect?"
        );

        if (!confirmed) return;

        $("#logoutBtn").disabled = true;
        $("#accountLogoutBtn").disabled = true;

        try {
            await apiRequest(API.logout, { method: "POST" });
        } catch (error) {
            console.error("Logout request:", error.message);
        } finally {
            window.location.assign("/login/login.html");
        }
    }

    function bindEvents() {
        document.querySelectorAll("[data-section]").forEach(link => {
            link.addEventListener("click", event => {
                event.preventDefault();
                showSection(link.dataset.section);
            });
        });

        document.querySelectorAll("[data-go]").forEach(button => {
            button.addEventListener("click", () => {
                showSection(button.dataset.go);
            });
        });

        $("#productSearch").addEventListener("input", renderMarketplace);
        $("#sortProducts").addEventListener("change", renderMarketplace);
        $("#orderSearch").addEventListener("input", renderOrders);
        $("#orderStatusFilter").addEventListener("change", renderOrders);

        $("#refreshProducts").addEventListener("click", loadProducts);
        $("#refreshOrders").addEventListener("click", loadOrders);

        $("#productsContainer").addEventListener("click", event => {
            const button = event.target.closest("[data-order-product]");
            if (button && !button.disabled) {
                openOrderModal(button.dataset.orderProduct);
            }
        });

        $("#featuredProducts").addEventListener("click", event => {
            const button = event.target.closest("[data-order-product]");
            if (button && !button.disabled) {
                openOrderModal(button.dataset.orderProduct);
            }
        });

        $("#productsContainer").addEventListener("click", event => {
            if (event.target.closest("#retryProducts")) loadProducts();
        });

        $("#closeOrderModal").addEventListener("click", closeOrderModal);

        $("#orderModal").addEventListener("click", event => {
            if (event.target === $("#orderModal")) closeOrderModal();
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && !$("#orderModal").hidden) {
                closeOrderModal();
            }
        });

        $("#orderQuantity").addEventListener("input", updateOrderTotal);
        $("#orderForm").addEventListener("submit", placeOrder);

        $("#decreaseQuantity").addEventListener("click", () => {
            const input = $("#orderQuantity");
            input.value = String(Math.max(1, Number(input.value || 1) - 1));
            updateOrderTotal();
        });

        $("#increaseQuantity").addEventListener("click", () => {
            const input = $("#orderQuantity");
            const maximum = Number(input.max || 999999);
            input.value = String(Math.min(maximum, Number(input.value || 0) + 1));
            updateOrderTotal();
        });

        $("#menuToggle").addEventListener("click", () => {
            $("#sidebar").classList.toggle("open");
        });

        $("#logoutBtn").addEventListener("click", logout);
        $("#accountLogoutBtn").addEventListener("click", logout);

        window.addEventListener("hashchange", () => {
            showSection(window.location.hash.slice(1) || "overview");
        });
    }

    async function initialize() {
        $("#currentYear").textContent = new Date().getFullYear();
        bindEvents();

        try {
            const data = await apiRequest(API.me);
            const user = data.user || data;

            displayUser(user);

            if (user.role && String(user.role).toLowerCase() !== "buyer") {
                return;
            }

            showSection(window.location.hash.slice(1) || "overview");

            await Promise.all([
                loadProducts(),
                loadOrders()
            ]);
        } catch (error) {
            console.error("Buyer dashboard initialization:", error);
            showMessage(
                error.message || "Unable to initialize the dashboard.",
                "error"
            );
        }
    }

    initialize();
});
